# ─── Supabase ──────────────────────────────────────────────────────────────────
# Encontre em: supabase.com → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Gere uma string aleatória segura (mínimo 32 caracteres)
# Exemplo: openssl rand -base64 32
# Obrigatório em produção e em previews — sem ele a app recusa assinar/verificar tokens.
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# ─── Fuso horário da empresa ─────────────────────────────────────────────────────
# Nome IANA do fuso onde a empresa opera. Define o "dia de trabalho" local usado para
# datar as batidas (em vez de UTC). Precisa do prefixo NEXT_PUBLIC_ para o servidor e o
# cliente usarem o mesmo valor. Ex.: Europe/Madrid, Europe/Lisbon, America/Sao_Paulo.
NEXT_PUBLIC_BUSINESS_TZ=Europe/Madrid

# ─── Multi-tenancy: subdomínio por empresa (opcional) ────────────────────────────
# Domínio raiz que serve um subdomínio por tenant: com o valor "pontoglass.app",
# "empresa-a.pontoglass.app" autentica contra o tenant de slug "empresa-a".
# Requer wildcard *.dominio apontado para o deployment (ver docs/TENANTS.md).
# Vazio = roteamento por subdomínio desligado; todo host usa o tenant default
# (comportamento single-tenant). Domínios custom (tenants.domain) funcionam
# independentemente desta variável.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=

# ─── Admin inicial (apenas no primeiro arranque) ─────────────────────────────────
# Na primeira vez que a base está vazia, a app cria o admin com ESTA senha (mín. 8).
# Defina antes do primeiro login, faça login e depois REMOVA do ambiente.
# (Não há mais senha padrão "admin123" embutida.)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ─── Recuperação de acesso ───────────────────────────────────────────────────────
# Chave secreta para reset de senha sem login. Contas admin NÃO podem ser repostas por
# esta via (usam a recuperação por e-mail) — assim uma fuga desta chave não compromete o admin.
# Guarde em local seguro — quem tiver essa chave pode redefinir a senha de não-admins.
# Exemplo: openssl rand -base64 32
RECOVERY_SECRET=

# ─── Rate limit distribuído (opcional, recomendado em produção) ──────────────────
# Sem isto, o limite de tentativas de login é por-instância/em memória (pouco eficaz em
# serverless). Crie um Vercel KV ou Upstash Redis e cole as credenciais REST aqui.
# A integração Vercel KV define KV_REST_API_URL/KV_REST_API_TOKEN automaticamente;
# o Upstash direto usa UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN. Qualquer par serve.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Cron (verificação de ausências) ─────────────────────────────────────────────
# Protege o endpoint /api/cron/absence-check. O Vercel Cron envia "Authorization: Bearer <isto>".
# Sem este valor o endpoint fica inacessível (recusa todas as chamadas).
# Exemplo: openssl rand -base64 32
CRON_SECRET=

# ─── Web Push (PWA Push Notifications) ──────────────────────────────────────────
# Gere um par de chaves VAPID com:
#   node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# A chave pública deve começar com NEXT_PUBLIC_ para ser exposta ao cliente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contacto para o servidor de push (ex: mailto:admin@empresa.com)
VAPID_EMAIL=mailto:admin@empresa.com

# ─── Email (notificações de correcções) ─────────────────────────────────────────
# Se não configurado, as notificações por email são ignoradas silenciosamente.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=o teu email, SMTP_PASS=app password
# (Criar app password em: myaccount.google.com → Segurança → Palavras-passe de aplicações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PontoGlass <noreply@empresa.com>
# URL pública da app (usado nos links dos emails)
NEXT_PUBLIC_APP_URL=https://ponto-glass-next.vercel.app

# ─── Microsoft Graph API (e-mail sem licença por caixa) ───────────────────────
# Substitui SMTP quando todas as 4 variáveis estão definidas.
# Setup: Microsoft 365 Admin → Azure AD → App Registrations → client_credentials.
# Permissão necessária: Mail.Send (aplicação). Não requer licença por caixa.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=relatorios@suaempresa.com

# ─── Sentry (monitorização de erros) ─────────────────────────────────────────
# Criar projecto em sentry.io e copiar o DSN aqui.
# SENTRY_AUTH_TOKEN: necessário para upload de source maps (CI/CD).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
