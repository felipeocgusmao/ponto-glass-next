# ─── Supabase ──────────────────────────────────────────────────────────────────
# Encontre em: supabase.com → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Gere uma string aleatória segura (mínimo 32 caracteres)
# Exemplo: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres

# ─── Recuperação de acesso ───────────────────────────────────────────────────────
# Chave secreta para reset de senha sem login (admin bloqueado).
# Guarde em local seguro — quem tiver essa chave pode redefinir qualquer senha.
# Exemplo: openssl rand -base64 32
RECOVERY_SECRET=

# ─── Web Push (PWA Push Notifications) ──────────────────────────────────────────
# Gere um par de chaves VAPID com:
#   node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# A chave pública deve começar com NEXT_PUBLIC_ para ser exposta ao cliente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contacto para o servidor de push (ex: mailto:admin@empresa.com)
VAPID_EMAIL=mailto:admin@empresa.com
