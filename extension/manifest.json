{
  "manifest_version": 3,
  "name": "PontoGlass — Ponto rápido",
  "version": "0.2.0",
  "description": "Bata o ponto e veja o resumo do dia direto do navegador. Reaproveita a sua sessão já logada no PontoGlass.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PontoGlass",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["geolocation", "offscreen"],
  "host_permissions": ["https://ponto-glass-next.vercel.app/*"]
}
